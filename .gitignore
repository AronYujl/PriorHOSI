__pycache__/
.idea/
*.pyc
*.blend
*.npy
*.npz
*.tar
*.json
*.csv
*.obj
*.mp4
*.pkl
*.jpg
results/
checkpoint/
smpl_models/
t2m_eval/
data
.codegraph/

# Research governance metadata is intentionally small and versioned. Large
# per-sample outputs remain ignored under results/.
!experiments/
!experiments/results/
!experiments/**/*.json
!experiments/**/*.jsonl
!experiments/**/*.csv
third_party/

# Agent scratch space. Subagents write long logs/tables/diffs here instead of
# returning them inline. Must stay ignored: tools/experiment.py treats any
# untracked file as a dirty worktree and refuses to start a reportable run.
.claude/scratch/

# Local session transcript dumps written at the repository root. Same reason as
# above: an untracked file blocks every reportable training/evaluation start.
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Host-local asset roots, ignored again WITHOUT a trailing slash. In the main
# checkout these are real directories, so the `results/` style patterns above
# match them; in a git worktree they are symlinks into the main checkout, which
# `dir/` does not match. The HSI branch cut on 2026-08-10 committed three of
# them as mode-120000 blobs holding absolute paths for exactly this reason.
/results
/checkpoint
/smpl_models
/third_party
/data

# Session-local git worktrees. Only their branches are shared.
/.claude/worktrees/
